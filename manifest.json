{
  "manifest_version": 3,
  "name": "JoSan Extension",
  "version": "2.0.0",
  "description": "AI-powered content moderation that intelligently detects and filters profanity, harassment, and hate speech using context-aware analysis.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.instagram.com/*",
        "*://*.reddit.com/*",
        "*://*.linkedin.com/*",
        "*://*.tiktok.com/*",
        "*://*.youtube.com/*",
        "*://*.tumblr.com/*",
        "*://*.quora.com/*",
        "*://*.threads.net/*",
        "*://*.discord.com/*",
        "*://*.bsky.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end",
      "exclude_globs": [
        "*://*/messages/*",
        "*://*/inbox/*",
        "*://*/chat/*",
        "*://*/dm/*",
        "*://*/direct/*",
        "*://*/conversations/*"
      ]
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.instagram.com/*",
    "*://*.reddit.com/*",
    "*://*.linkedin.com/*",
    "*://*.tiktok.com/*",
    "*://*.youtube.com/*",
    "*://*.tumblr.com/*",
    "*://*.quora.com/*",
    "*://*.threads.net/*",
    "*://*.discord.com/*",
    "*://*.bsky.app/*",
    "https://api.openai.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/en.txt"],
      "matches": ["<all_urls>"]
    }
  ]
}
